{
  "//": "Merge into ~/.claude/settings.json (user-level, applies to every project).",
  "permissions": {
    "allow": [
      "Bash(openscope:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/openscope-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/openscope-guard.sh"
          }
        ]
      }
    ]
  }
}
