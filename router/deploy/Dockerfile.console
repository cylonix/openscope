# openscope-console — read API for the governance dashboards.
#
# Build context is the REPO ROOT (the router module replaces
# github.com/openscope/openscope with ../):
#   docker build -f router/deploy/Dockerfile.console -t openscope-console .

FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY router/go.mod router/go.sum ./router/
RUN cd router && go mod download
COPY . .
RUN CGO_ENABLED=0 go build -C router -trimpath -ldflags="-s -w" \
      -o /out/openscope-console ./cmd/openscope-console

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata wget && \
    addgroup -S openscope && adduser -S openscope -G openscope
COPY --from=build /out/openscope-console /usr/local/bin/
USER openscope
EXPOSE 8081
ENTRYPOINT ["openscope-console"]
