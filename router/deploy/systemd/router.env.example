# OpenScope router stack — copy to /etc/openscope/router.env (mode 600).
# Generate the secrets with: scripts/generate_secrets.sh

# Postgres (managed PG or local). The role-scoped DSNs enforce the privacy
# boundary at the database engine — see db/migrations/0001_init.sql.
OPENSCOPE_DATABASE_URL=postgres://app_rw:CHANGE_ME@db-host:5432/openscope
OPENSCOPE_ADMIN_DSN=postgres://openscope_admin:CHANGE_ME@db-host:5432/openscope
OPENSCOPE_TENANT_READER_DSN=postgres://tenant_reader:CHANGE_ME@db-host:5432/openscope
OPENSCOPE_VENDOR_READER_DSN=postgres://vendor_reader:CHANGE_ME@db-host:5432/openscope

# Secrets (generate_secrets.sh)
OPENSCOPE_AUTH_PEPPER=
OPENSCOPE_SESSION_SECRET=
OPENSCOPE_ADMIN_TOKEN=
OPENSCOPE_RECEIPT_PRIVATE_KEY=
OPENSCOPE_RECEIPT_PUBLIC_KEY_ID=self-hosted-1

# Provider: bedrock (default) or mock (offline evaluation).
OPENSCOPE_PROVIDER=bedrock
OPENSCOPE_BEDROCK_INVOKE_ROLE_ARN=
OPENSCOPE_BEDROCK_EXTERNAL_ID=
OPENSCOPE_BEDROCK_REGION=us-west-2
OPENSCOPE_DEFAULT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Governance
#OPENSCOPE_ENABLED_MODELS=us.anthropic.claude-haiku-4-5-20251001-v1:0
#OPENSCOPE_DEFAULT_MONTHLY_BUDGET_USD=25
#OPENSCOPE_RESTRICTED_WORKSPACES=secret-rtl,fab-bringup
#OPENSCOPE_DLP_RULES_FILE=/etc/openscope/dlp.yaml
#OPENSCOPE_POLICY_VERSION=2026-06-policy-1
#OPENSCOPE_AUDIT_JSONL_PATH=/var/lib/openscope/audit.jsonl
#OPENSCOPE_BODY_RETENTION_MINUTES=0

# TLS (or terminate at your proxy/LB)
#OPENSCOPE_TLS_CERT_FILE=/etc/openscope/tls/cert.pem
#OPENSCOPE_TLS_KEY_FILE=/etc/openscope/tls/key.pem

# Control plane (optional)
#OPENSCOPE_CONTROL_PLANE_URL=https://cp.openscopeai.com
#OPENSCOPE_DEPLOYMENT_TOKEN=osk_deploy_...
