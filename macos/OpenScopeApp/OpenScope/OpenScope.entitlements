<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required under Hardened Runtime to send Apple Events via NSAppleScript.
	     Without this, Apple Events are silently blocked before TCC is consulted. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
