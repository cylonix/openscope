# postinstall — runs as root after OpenScope.app is copied to /Applications.
#
# Phase-4 two-daemon model:
#   - Root LaunchDaemon (/Library/LaunchDaemons): openscoped as root — policy,
#     audit, keys, ssh, system, the CLI socket.
#   - Session LaunchAgent (console user's ~/Library/LaunchAgents): openscoped
#     --session-helper — holds Notes/Mail TCC, runs asapple for the root daemon.
# Policy is root-owned in the admin dir; the agent can read but not edit it.

set -euo pipefail

APP="/Applications/OpenScope.app"
BIN_DIR="$APP/Contents/Resources/bin"
LAUNCHD_SRC="$APP/Contents/Resources/launchd"
DAEMON_PLIST="com.ezblock.openscope.openscoped.plist"
SESSION_PLIST="com.ezblock.openscope.session.plist"
DAEMON_LABEL="com.ezblock.openscope.openscoped"
SESSION_LABEL="com.ezblock.openscope.session"

CLI_SRC="$BIN_DIR/openscope"
CLI_LINK="/usr/local/bin/openscope"
PILOT_SRC_DIR="/usr/local/lib/openscope/pilot"
PILOT_LINK="/usr/local/bin/openscope-diag"

ADMIN_DIR="/Library/Application Support/OpenScope"
SYSTEM_RUN_DIR="/var/run/openscope"

# ── Console user (the human logged in; postinstall itself runs as root) ───────
CONSOLE_USER=$( scutil <<< "show State:/Users/ConsoleUser" \
  | awk '/Name :/ && !/loginwindow/ { print $3; exit }' )
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ]; then
  echo "postinstall: no console user detected, skipping per-user setup" >&2
  exit 0
fi
CONSOLE_UID=$(id -u "$CONSOLE_USER")
USER_HOME=$(eval echo "~$CONSOLE_USER")
LAUNCH_AGENTS_DIR="$USER_HOME/Library/LaunchAgents"
CONFIG_DIR="$USER_HOME/.openscope"

# The session socket lives in the console user's home (the session agent runs as
# that user and binds it; the root daemon connects down to it). Templated into
# both plists below.
SESSION_RUN_DIR="$USER_HOME/Library/Application Support/OpenScope/run"
SESSION_SOCKET="$SESSION_RUN_DIR/session.sock"

echo "postinstall: setting up OpenScope (two-daemon) for $CONSOLE_USER (uid $CONSOLE_UID)"

# ── CLI symlinks ──────────────────────────────────────────────────────────────
mkdir -p /usr/local/bin
ln -sf "$CLI_SRC" "$CLI_LINK"
echo "postinstall: $CLI_LINK -> $CLI_SRC"
if [ -f "$PILOT_SRC_DIR/pilot_test.sh" ]; then
  ln -sf "$PILOT_SRC_DIR/pilot_test.sh" "$PILOT_LINK"
fi

# ── Root-owned directories ────────────────────────────────────────────────────
mkdir -p "$ADMIN_DIR"
chown root:wheel "$ADMIN_DIR"
chmod 755 "$ADMIN_DIR"

mkdir -p "$SYSTEM_RUN_DIR"          # root daemon's CLI socket dir
chown root:wheel "$SYSTEM_RUN_DIR"
chmod 755 "$SYSTEM_RUN_DIR"

# ── Per-user directories ──────────────────────────────────────────────────────
mkdir -p "$CONFIG_DIR" "$CONFIG_DIR/apps.d" "$CONFIG_DIR/state" "$CONFIG_DIR/run"
chown -R "$CONSOLE_USER" "$CONFIG_DIR"
mkdir -p "$SESSION_RUN_DIR"
chown -R "$CONSOLE_USER" "$USER_HOME/Library/Application Support/OpenScope"

# ── Policy: root-owned in the admin dir (agent can read, not edit) ────────────
ADMIN_POLICY="$ADMIN_DIR/policies.yaml"
LEGACY_POLICY="$CONFIG_DIR/policies.yaml"
if [ ! -f "$ADMIN_POLICY" ]; then
  if [ -f "$LEGACY_POLICY" ]; then
    mv "$LEGACY_POLICY" "$ADMIN_POLICY"
    echo "postinstall: migrated existing policy to $ADMIN_POLICY"
  else
    cat > "$ADMIN_POLICY" <<'EOF'
version: 1
rules:
    - effect: allow
      agent: openclaw
      app: notes
      action: list_notes
    - effect: allow
      agent: openclaw
      app: notes
      action: read_note
    - effect: allow
      agent: openclaw
      app: mail
      action: list_messages
      constraints:
        mailbox: Inbox
    - effect: allow
      agent: openclaw
      app: mail
      action: read_message
      constraints:
        mailbox: Inbox
EOF
    echo "postinstall: seeded default policy at $ADMIN_POLICY"
  fi
fi
chown root:wheel "$ADMIN_POLICY"
chmod 644 "$ADMIN_POLICY"           # world-readable so the daemon reads it; root-writable only
rm -f "$LEGACY_POLICY"              # no user-writable copy may linger

# ── Agents registry (per-user; not an escalation vector without a policy rule) ─
AGENTS_FILE="$CONFIG_DIR/agents.yaml"
if [ ! -f "$AGENTS_FILE" ]; then
  printf 'version: 1\nagents:\n    - openclaw\n' > "$AGENTS_FILE"
  chown "$CONSOLE_USER" "$AGENTS_FILE"
fi

# ── Admin blacklists (root-owned) ─────────────────────────────────────────────
PROTECTED_FOLDERS_FILE="$ADMIN_DIR/protected_folders.yaml"
if [ ! -f "$PROTECTED_FOLDERS_FILE" ]; then
  printf 'version: 1\nkeywords:\n  - private\n  - hidden\n' > "$PROTECTED_FOLDERS_FILE"
  chmod 644 "$PROTECTED_FOLDERS_FILE"
fi
MAIL_FILTERS_FILE="$ADMIN_DIR/mail_filters.yaml"
if [ ! -f "$MAIL_FILTERS_FILE" ]; then
  printf 'version: 1\nallowed_sender_domains: []\n' > "$MAIL_FILTERS_FILE"
  chmod 644 "$MAIL_FILTERS_FILE"
fi

# ── Root LaunchDaemon ─────────────────────────────────────────────────────────
DAEMON_DST="/Library/LaunchDaemons/$DAEMON_PLIST"
sed -e "s|__SESSION_SOCKET__|$SESSION_SOCKET|g" \
    -e "s|__CONFIG_DIR__|$CONFIG_DIR|g" \
    "$LAUNCHD_SRC/$DAEMON_PLIST" > "$DAEMON_DST"
chown root:wheel "$DAEMON_DST"
chmod 644 "$DAEMON_DST"
launchctl bootout "system/$DAEMON_LABEL" 2>/dev/null || true
launchctl bootstrap system "$DAEMON_DST"
launchctl kickstart -k "system/$DAEMON_LABEL"
echo "postinstall: root LaunchDaemon bootstrapped"

# ── Session LaunchAgent (console user, GUI session, holds TCC) ────────────────
mkdir -p "$LAUNCH_AGENTS_DIR"
chown "$CONSOLE_USER" "$LAUNCH_AGENTS_DIR"
SESSION_DST="$LAUNCH_AGENTS_DIR/$SESSION_PLIST"
sed "s|__SESSION_SOCKET__|$SESSION_SOCKET|g" "$LAUNCHD_SRC/$SESSION_PLIST" > "$SESSION_DST"
chown "$CONSOLE_USER" "$SESSION_DST"
# Retire the legacy per-user openscoped LaunchAgent (replaced by the root daemon).
launchctl bootout "gui/$CONSOLE_UID/$DAEMON_LABEL" 2>/dev/null || true
rm -f "$LAUNCH_AGENTS_DIR/$DAEMON_PLIST"
launchctl bootout "gui/$CONSOLE_UID/$SESSION_LABEL" 2>/dev/null || true
launchctl bootstrap "gui/$CONSOLE_UID" "$SESSION_DST"
launchctl kickstart -k "gui/$CONSOLE_UID/$SESSION_LABEL"
echo "postinstall: session LaunchAgent bootstrapped"

# ── Trigger the Notes Automation (TCC) prompt for the session agent ───────────
launchctl asuser "$CONSOLE_UID" /usr/bin/open "$APP"

echo "postinstall: done"
exit 0
