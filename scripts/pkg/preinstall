# preinstall — runs as root before OpenScope.app is installed. Stops any running
# OpenScope jobs to avoid conflicts during upgrade: the root LaunchDaemon, the
# session LaunchAgent, and the legacy per-user openscoped LaunchAgent.

set -euo pipefail

DAEMON_LABEL="com.ezblock.openscope.openscoped"
SESSION_LABEL="com.ezblock.openscope.session"

# Root LaunchDaemon (phase 4).
launchctl bootout "system/$DAEMON_LABEL" 2>/dev/null || true

CONSOLE_USER=$( scutil <<< "show State:/Users/ConsoleUser" \
  | awk '/Name :/ && !/loginwindow/ { print $3; exit }' )
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
  CONSOLE_UID=$(id -u "$CONSOLE_USER")
  launchctl bootout "gui/$CONSOLE_UID/$SESSION_LABEL" 2>/dev/null || true
  # Legacy per-user openscoped LaunchAgent (pre-phase-4).
  launchctl bootout "gui/$CONSOLE_UID/$DAEMON_LABEL" 2>/dev/null || true
fi

echo "preinstall: stopped existing OpenScope jobs (if running)"
exit 0
