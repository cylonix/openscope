# preinstall — runs as root before OpenScope.app is installed.
# Unloads any running openscoped LaunchAgent to avoid conflicts during upgrade.

set -euo pipefail

PLIST_LABEL="com.ezblock.openscope.openscoped"

CONSOLE_USER=$( scutil <<< "show State:/Users/ConsoleUser" \
  | awk '/Name :/ && !/loginwindow/ { print $3; exit }' )

if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ]; then
  exit 0
fi

CONSOLE_UID=$(id -u "$CONSOLE_USER")

# Gracefully stop the daemon if it is running
launchctl bootout "gui/$CONSOLE_UID/$PLIST_LABEL" 2>/dev/null || true
echo "preinstall: stopped existing openscoped (if running)"

exit 0
