.DS_Store
.agentscope/
.cache/
bin/

# Xcode build artifacts
.xcodebuild/
*.xcuserdatad/

# Distribution artifacts (built, not checked in)
dist/
dist/export/
dist/*.pkg

# Marketing site — its own repo (cylonix/openscope-web), root only.
# router/web (console dashboard) IS tracked here.
/web/

# Local script caches
scripts/__pycache__/

# Local developer config (contains signing credentials)
.env.local

# Claude Code local config (machine-specific)
.claude/settings.local.json

# Codex local notes (machine-specific, untracked)
.codex-local/

# Docs artifacts
docs/diagrams/*.pdf
docs/diagrams/*.key
docs/*.pdf

*.tar

# Live droplet infra (private). deploy/broker and router/deploy ARE tracked.
/deploy/docker-compose-openscope.yml
/deploy/traefik/

# SSO smoke working dir — generated keys, tokens, rendered nginx.conf.
/deploy/broker/sso/.smoke/
