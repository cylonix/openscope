# Local developer configuration — copy to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# Your Apple Developer Team ID (10-character alphanumeric string).
# Found at: https://developer.apple.com/account → Membership → Team ID
# Used by scripts/build_pkg.sh to select the right signing identity.
AGENTSCOPE_TEAM_ID=XXXXXXXXXX
