# OpenScope broker environment — copy to /etc/openscope/openscoped.env (mode 600).

# Daemon state (token store, policies, audit log). The systemd unit grants
# write access to /var/lib/openscope.
OPENSCOPE_CONFIG_DIR=/var/lib/openscope

# Admin configs: ssh_targets.yaml, http_profiles.yaml, system_commands.yaml.
OPENSCOPE_ADMIN_DIR=/etc/openscope

# Network listener. Agents authenticate with Bearer tokens minted via:
#   sudo -u openscope OPENSCOPE_CONFIG_DIR=/var/lib/openscope \
#     openscope agent token mint <agent_id>
OPENSCOPE_HTTP_LISTEN=:8443

# TLS — either terminate here...
#OPENSCOPE_HTTP_TLS_CERT=/etc/openscope/tls/cert.pem
#OPENSCOPE_HTTP_TLS_KEY=/etc/openscope/tls/key.pem
# ...or at a reverse proxy / load balancer, acknowledging plaintext upstream:
#OPENSCOPE_HTTP_PLAINTEXT_OK=1

# Token pepper. If unset, an auto-generated pepper is stored at
# $OPENSCOPE_CONFIG_DIR/token_pepper — BACK IT UP; losing it invalidates
# every minted agent token.
#OPENSCOPE_AUTH_PEPPER=

# SSO human auth (optional). Set when an OIDC reverse proxy (oauth2-proxy,
# ALB OIDC, Google IAP, Cloudflare Access) sits in front. The proxy must
# present a trusted-proxy token:
#   openscope agent token mint --trusted-proxy sso-proxy
# Only then is the forwarded user header trusted. Keep the broker reachable
# only from the proxy. See docs/enterprise-broker.md and deploy/broker/sso/.
#OPENSCOPE_HTTP_TRUST_PROXY=1
#OPENSCOPE_HTTP_PROXY_USER_HEADER=X-Forwarded-Email
#OPENSCOPE_HTTP_PROXY_GROUPS_HEADER=X-Forwarded-Groups

# Control plane (optional; omit to run fully standalone).
#OPENSCOPE_CONTROL_PLANE_URL=https://cp.openscopeai.com
#OPENSCOPE_DEPLOYMENT_TOKEN=osk_deploy_...
